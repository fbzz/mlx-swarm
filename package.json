{
  "name": "mlx-swarm-desktop",
  "version": "0.5.1",
  "description": "Standalone Beautiful UI desktop shell for MLX Swarm",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --config desktop/vite.config.ts",
    "build": "vite build --config desktop/vite.config.ts",
    "test": "vitest run --config desktop/vite.config.ts",
    "desktop": "electron desktop/main.cjs",
    "postinstall": "electron-rebuild -f -w node-pty"
